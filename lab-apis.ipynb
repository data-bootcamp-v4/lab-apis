# --- EXERCICE 1 ---

artists = ["The Weeknd", "Bruno Mars", "Maroon 5"]

def get_top_tracks (artist_name):
    result = sp.search(q=artist_name, type="artist", limit=1)
    artist_id = result["artists"]["items"][0]["id"]
    top_tracks = sp.artist_top_tracks(artist_id)
    return [track["name"] for track in top_tracks["tracks"][:5]]

top_tracks_list = [get_top_tracks(artist) for artist in artists]
top_tracks_list

def find_related_artists(artist_name):
    result = sp.search(q=artist_name, type="artist", limit=1)
    artist_id = result["artists"]["items"][0]["id"]
    related = sp.artist_related_artists(artist_id)
    return [artist["name"] for artist in related["artists"][:5]]

related_artists_list = [find_related_artists(artist) for artist in artists]
related_artists_list

# --- CHALLENGE ---

def get_artist_id(artist_name):
    result = sp.search(q=artist_name, type="artist", limit=1)
    return result["artists"]["items"][0]["id"]

def get_top_tracks(artist_name):
    artist_id = get_artist_id(artist_name)
    top = sp.artist_top_tracks(artist_id)
    return [track["name"] for track in top["tracks"][:5]]

def find_related_artists(artist_name):
    artist_id = get_artist_id(artist_name)
    related = sp.artist_related_artists(artist_id)
    return [artist["name"] for artist in related["artists"][:5]]

artists = ["The Weeknd", "Bruno Mars", "Maroon 5"]
top_tracks_list = [get_top_tracks(a) for a in artists]
top_tracks_list

related_artists_list = [find_related_artists(a) for a in artists]
related_artists_list

related_tracks = []

for group in related_artists_list:     # ex : ["Artist1", "Artist2", ...]
    for artist in group:
        related_tracks.append(get_top_tracks(artist))

flat_related_tracks = [track for sublist in related_tracks for track in sublist]

final_playlist_tracks = []

# Ajouter top tracks des artistes préférés
for tracks in top_tracks_list:
    final_playlist_tracks.extend(tracks)

# Ajouter top tracks des artistes liés
final_playlist_tracks.extend(flat_related_tracks)

final_playlist_tracks


# --- EXERCICE 2 ---

featured = sp.featured_playlists()

# Extraire les 5 premières playlists
top5_playlists = featured["playlists"]["items"][:5]

# Afficher nom + ID
for p in top5_playlists:
    print("Name:", p["name"])
    print("ID:", p["id"])
    print("---")

chosen_playlist_id = top5_playlists[0]["id"]

playlist = sp.playlist(chosen_playlist_id)

print("Name:", playlist["name"])
print("Description:", playlist["description"])
print("Total tracks:", playlist["tracks"]["total"])

tracks_data = sp.playlist_tracks(chosen_playlist_id)

first10 = tracks_data["items"][:10]

for t in first10:
    print(t["track"]["name"])

track_artist_dict = {}

for item in first10:
    track = item["track"]
    track_name = track["name"]

    artists = [artist["name"] for artist in track["artists"]]

    track_artist_dict[track_name] = artists

track_artist_dict
